@echo off
rem Simulate the two HLS cores with Icarus Verilog and draw the waveform figure
rem of the report: ..\report\figures\wave_v1.png and wave_v2.png, then pack
rem ..\report\overleaf_project.zip again.
rem The cores are the Verilog generated by Vitis HLS 2021.1, copied into rtl\v1
rem and rtl\v2, so Vitis is not needed here.
rem Needs Icarus Verilog (iverilog and vvp on the PATH, https://bleyer.org/icarus)
rem and Python 3 with Pillow. Version 1 takes about 7 minutes, version 2 about 2.
cd /d "%~dp0"
set RTL1=rtl\v1
set RTL2=rtl\v2
(for %%f in (%RTL1%\*.v) do @echo %%f) > files_v1.txt
(for %%f in (%RTL2%\*.v) do @echo %%f) > files_v2.txt
iverilog -DCORE_V1 -DDUMP_VCD -s tb_min_hamming -o v1.vvp -c files_v1.txt tb_min_hamming.v || exit /b 1
iverilog -DCORE_V2 -DDUMP_VCD -s tb_min_hamming -o v2.vvp -c files_v2.txt tb_min_hamming.v || exit /b 1
vvp -n v1.vvp || exit /b 1
vvp -n v2.vvp || exit /b 1
del files_v1.txt files_v2.txt v1.vvp v2.vvp
python plot_waves.py || exit /b 1
powershell -NoProfile -ExecutionPolicy Bypass -File ..\report\make_overleaf_zip.ps1
